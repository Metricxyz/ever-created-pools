# Single Alchemy key — the script builds every chain's RPC URL from this key via
# ALCHEMY_NETWORK_SLUGS in lib/env.ts. Verified live (eth_chainId round-trip) for
# all 10 deployed chains: Ethereum, Base, Arbitrum, Avalanche, BNB, Polygon, MegaETH,
# HyperEVM, Monad, and the Robinhood chain. Same key as metric-deploy's ALCHEMY_API_KEY.
ALCHEMY_API_KEY=

# Block range per eth_getLogs call. The script shrinks this automatically on
# "range too large" / "too many results" errors from the RPC provider, so this is just
# the starting point — raise it for providers with generous limits, lower it if you see
# a lot of shrink-retry log lines.
CHUNK_SIZE=50000

# fromBlock used for factories with no known deployment block in deploy-blocks.json
# (currently: the whole v0 lineage, plus two short-lived v1 factories that were replaced
# within minutes — see deploy-blocks.json's "unknown" list). 0 = scan from genesis, which
# is correct but slow on long-lived chains; set a tighter estimate per-chain if you know one.
DEFAULT_FROM_BLOCK=0
